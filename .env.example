# Copy to .env and fill in. Empty values use the defaults.

# Required for chatting (not for tests).
GEMINI_API_KEY=

# Default: gemini-3.1-flash-lite. Others: gemini-2.5-flash-lite (cheaper), gemini-3.5-flash-lite
LLM_MODEL=

# Seconds the tools of one round may take together (default: 5)
TOOL_TIMEOUT_S=

# Folder for app.db and sample.db (default: data; /app/data in Docker, on the volume)
DATA_DIR=

# Host port for the API (default: 8000)
API_PORT=
